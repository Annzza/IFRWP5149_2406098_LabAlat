em&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot; colspan=&quot;3&quot;&gt;&lt;b&gt;Skenario Normal&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Membuka fungsi Melihat Jadwal Kuliah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Menampilkan daftar semester&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Memilih semester&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Menampilkan jadwal kuliah berisi mata kuliah, hari, jam, dan ruang&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot; colspan=&quot;3&quot;&gt;&lt;b&gt;Skenario Alternative&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Jadwal kuliah semester