-align:top;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot; colspan=&quot;3&quot;&gt;&lt;b&gt;Skenario Normal&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Membuka fungsi Mengajukan KRS&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Menampilkan daftar mata kuliah yang ditawarkan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Memilih mata kuliah yang akan diambil&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Memvalidasi pilihan mata kuliah (Validasi KRS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Mengajukan KRS&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Menyimpan pengajuan KRS dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot; colspan=&quot;3&quot;&gt;&lt;b&gt;Skenario Alternative&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Pilihan mata kuliah tidak valid (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot;&gt;Menolak pengajuan dan menampilkan pesan kesalahan validasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:3px 6px;vertical-align:top;&quot; colspan=&quot;3&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Selesai jika pengajuan KRS tersimpan; jika validasi gagal, KRS tidak diajukan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
